# --- LLM Provider Credentials ---
# HF_TOKEN is injected automatically by the hackathon validator.
# Set it manually for local development.
HF_TOKEN=your-api-key-here

# API_BASE_URL: Any OpenAI-compatible endpoint.
# Groq:   https://api.groq.com/openai/v1
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# Ollama: http://localhost:11434/v1
API_BASE_URL=https://router.huggingface.co/v1

# MODEL_NAME: The model identifier to use.
MODEL_NAME=Qwen/Qwen2.5-72B-Instruct

# --- Environment Configuration ---
# URL where the OpenEnv server is running.
# Default: http://localhost:8000
ENV_BASE_URL=http://localhost:8000
