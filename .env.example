# Hugging Face / OpenAI credentials and endpoints
# HF_TOKEN: Your Hugging Face API key or OpenAI compatible key
HF_TOKEN=gsk_
# OPENAI_API_KEY=optional, if you also use OpenAI tokens directly
OPENAI_API_KEY=your-openai-key-here

# API base URL for the LLM provider (used by inference.py OpenAI client by default)
API_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME: model to use for generation (e.g., gpt-4o, gpt-3.5-turbo, etc.)
MODEL_NAME=openai/gpt-oss-120b

# Environment client base URL for the in-repo environment server
# Set this to point to a deployed HF/OpenEnv endpoint if not running locally
ENV_CLIENT_BASE_URL=https://saheb-content-moderation-env.hf.space

# Optional: other environment-specific overrides can go here
