# --- LLM Provider Credentials ---
# HF_TOKEN: Your API key (Hugging Face, Groq, OpenAI, etc.)
HF_TOKEN=your-api-key-here

# API_BASE_URL: The OpenAI-compatible endpoint URL
# Default (OpenAI): https://api.openai.com/v1
# Groq: https://api.groq.com/openai/v1
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
API_BASE_URL=https://api.openai.com/v1

# MODEL_NAME: The model identifier to use (e.g. gpt-4o, llama-3.3-70b-versatile)
MODEL_NAME=gpt-4o

# --- Environment Configuration ---
# ENV_CLIENT_BASE_URL: The URL where your OpenEnv server is running
# Default: https://saheb-content-moderation-env.hf.space
ENV_CLIENT_BASE_URL=https://saheb-content-moderation-env.hf.space
